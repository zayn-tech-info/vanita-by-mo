# Frontend (Vite) — use in .env.local or your host's env
# Do not commit real values. Copy to .env.local and fill in.

# Convex
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Stripe (use publishable key only in frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxx

# Optional: Convex HTTP URL if you need it in frontend
# VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
